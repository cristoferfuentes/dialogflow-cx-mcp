# =============================================================================
# Credenciales del MCP `cx-playbook` (Dialogflow CX).
# Copia este fichero a `.env` y rellena los valores.
# `.env` esta en el .gitignore del paquete.
#
# COMO OBTENER LAS CREDENCIALES -> README.md, seccion "Como obtener las
# credenciales". Resumen: en tu navegador, con la sesion de Google abierta en
# la consola de Conversational Agents, copia la cabecera `Cookie` de una
# peticion a `dialogflow.clients6.google.com` (DevTools > Network > la peticion
# > Request Headers > Cookie).
#
# ESTE MCP NO TIENE PROYECTO NI AGENTE CABLEADOS: todo lo de abajo es
# configuracion. No hay ninguna referencia a un proyecto o agente concreto.
# =============================================================================

# --- Proyecto ---------------------------------------------------------------
# Id del proyecto de Google Cloud. Es el proyecto por defecto de las llamadas.
CXP_PROJECT=mi-proyecto-de-google-cloud
CXP_LOCATION=global

# Proyecto de cuota (cabecera `x-goog-user-project`). Opcional: si no se pone,
# se usa CXP_PROJECT.
#CXP_QUOTA_PROJECT=mi-proyecto-de-google-cloud

# --- Origen de la consola (se usa en la firma SAPISIDHASH) ------------------
CXP_CONSOLE_ORIGIN=https://conversational-agents.cloud.google.com

# --- API key de la consola --------------------------------------------------
# La que usa la consola "Conversational Agents" (no es la de tu proyecto):
# es el parametro `key=` de las peticiones de la consola.
CXP_API_KEY=AIzaSyEXAMPLEKEY

# --- Credenciales (las 5 cookies OBLIGATORIAS) ------------------------------
# Pega aqui la cabecera `Cookie` copiada del navegador, tal cual.
CXP_COOKIE="SAPISID=...; SID=...; HSID=...; SSID=...; APISID=..."

# Alternativa: una cookie por variable (tienen prioridad sobre CXP_COOKIE).
#CXP_SAPISID=
#CXP_SID=
#CXP_HSID=
#CXP_SSID=
#CXP_APISID=

# Alternativa: un `storage_state` de Playwright del que se extraen las 5.
#CXP_SESSION_FILE=/ruta/a/storage_state.json

# --- Agentes ----------------------------------------------------------------
# Agente con el que se trabaja por defecto (el que se escribe).
CXP_DEFAULT_AGENT=<uuid-del-agente>

# --- PERMISOS POR AGENTE (lista blanca) -------------------------------------
# Un agente sin entrada en ninguna de las dos listas NO es accesible (ni para
# leer). Formas admitidas: <uuid> (vale en cualquier proyecto) o
# <proyecto>/<uuid> (empareja proyecto y agente).
#
# REGLA DURA: `CXP_AGENT_READWRITE` debe contener SOLO tu copia del agente.
# Nunca el agente de referencia ni el de produccion: se romperia la paridad
# con la consola.
#
# Lectura + escritura:
CXP_AGENT_READWRITE=<uuid-del-agente-escribible>

# Solo lectura (por ejemplo el agente original y el de produccion):
CXP_AGENT_READ=<uuid-original>,<uuid-de-produccion>

# (opcional) Limitar los proyectos a los que puede tocar el MCP:
#CXP_PROJECTS=mi-proyecto,mi-otro-proyecto

# (legacy) Agentes que NUNCA se pueden escribir -> se une a CXP_AGENT_READ.
#CXP_READ_ONLY_AGENTS=<uuid-original>

# --- Version del proto -------------------------------------------------------
# El espejo es v3beta1 (la API publica v3 descarta campos en silencio).
#CXP_API_VERSION=v3beta1

# --- Solo para el helper de login (fuera del MCP) ---------------------------
# Pantalla virtual del Chrome real y URL de noVNC para verlo por el navegador.
#CXP_DISPLAY=:99
#CXP_NOVNC_URL=http://localhost:6080/vnc.html
