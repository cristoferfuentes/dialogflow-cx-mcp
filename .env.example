# =============================================================================
# Credentials for the `dialogflow-cx-mcp` server (Dialogflow CX).
#
# Copy this file to `.env` and fill in the values.
# `.env` is in the package's .gitignore.
#
# HOW TO GET THE CREDENTIALS -> README.md, section "Get the credentials".
# In short: open the Conversational Agents console with your Google session,
# copy the `Cookie` header of a request to `dialogflow.clients6.google.com`
# (DevTools > Network > the request > Request Headers > Cookie).
#
# THIS MCP HAS NO PROJECT AND NO AGENT HARDWIRED: everything below is
# configuration. There is no reference to a concrete project or agent.
# =============================================================================

# --- Project ---------------------------------------------------------------
# Google Cloud project id. It is the default project for the calls.
CXP_PROJECT=my-gcp-project
CXP_LOCATION=global

# Quota project (`x-goog-user-project` header). Optional: if not set,
# CXP_PROJECT is used.
#CXP_QUOTA_PROJECT=my-gcp-project

# --- Console origin (used in the SAPISIDHASH signature) --------------------
CXP_CONSOLE_ORIGIN=https://conversational-agents.cloud.google.com

# --- Console API key -------------------------------------------------------
# The one used by the "Conversational Agents" console (it is NOT your project's
# key): it is the `key=` parameter of the console's requests.
# It is public and shared by every console user; replace it with the one you
# read from your own request if you prefer.
CXP_API_KEY=AIzaSyEXAMPLEKEY

# --- Credentials (the 5 mandatory cookies) ---------------------------------
# Paste here the `Cookie` header copied from the browser, as it is.
CXP_COOKIE="SAPISID=...; SID=...; HSID=...; SSID=...; APISID=..."

# Alternative: one cookie per variable (they take priority over CXP_COOKIE).
#CXP_SAPISID=
#CXP_SID=
#CXP_HSID=
#CXP_SSID=
#CXP_APISID=

# Alternative: a Playwright `storage_state` the 5 cookies are extracted from.
#CXP_SESSION_FILE=/path/to/storage_state.json

# --- Agents ----------------------------------------------------------------
# The agent worked on by default (the one that gets written).
CXP_DEFAULT_AGENT=<agent-uuid>

# --- PER-PERMISSION ALLOWLIST ----------------------------------------------
# An agent with no entry in either list is NOT accessible (not even to read).
# Accepted forms: <uuid> (valid in any project) or <project>/<uuid>
# (matches project and agent together).
#
# HARD RULE: `CXP_AGENT_READWRITE` must contain ONLY your own copy of the
# agent. Never the reference agent nor the production one: it would break
# parity with the console.
#
# Read + write:
CXP_AGENT_READWRITE=<agent-uuid>

# Read only (for example the original agent and the production one):
CXP_AGENT_READ=<original-agent-uuid>,<production-agent-uuid>

# (optional) Restrict the projects the MCP may touch:
#CXP_PROJECTS=my-gcp-project,my-other-project

# (legacy) Agents that can NEVER be written -> merged into CXP_AGENT_READ.
#CXP_READ_ONLY_AGENTS=<original-agent-uuid>

# --- Proto version ---------------------------------------------------------
# The mirror is v3beta1 (the public v3 API silently drops fields).
#CXP_API_VERSION=v3beta1

# --- Path of this file -----------------------------------------------------
# The MCP looks for the .env here first, then in the package root, then in the
# current directory, then in ~/.config/cx-playbook.env.
#CXP_ENV_FILE=/path/to/.env

# --- Only for the login helper (outside the MCP) ---------------------------
# Virtual screen of the real Chrome and the noVNC URL to watch it in a browser.
#CXP_DISPLAY=:99
#CXP_CDP_PORT=9222
#CXP_NOVNC_URL=http://localhost:6080/vnc.html

# --- Only for the probes (never hardcode these in the code) ----------------
# CXP_PROBE_AGENTS="default=<agent-uuid>"
# CXP_PROBE_TARGETS="default=<agent-uuid>,<flow-id>,<page-id>"
